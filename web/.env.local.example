# Firebase Web app config — mismos valores que mobile/.env (Firebase Console ->
# Project settings -> General -> "Your apps" -> Web app). Asegurate de que
# Authentication -> Sign-in method -> Email/Password esté habilitado.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Backend API base URL
NEXT_PUBLIC_API_URL=http://localhost:4000

# Base URL de la instancia de Odoo — para armar el link directo al ticket
# desde el detalle de cada hoja de conformidad. No es secreto (es solo el
# dominio), pero se deja como variable por si algún día cambia de instancia.
NEXT_PUBLIC_ODOO_BASE_URL=
