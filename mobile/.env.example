# Firebase Web app config — Firebase Console -> Project settings -> General ->
# "Your apps" -> Web app (</> icon). Register a Web app even though this is a
# React Native project: the Firebase JS SDK uses this config on all platforms.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google OAuth client IDs for Google Sign-In (expo-auth-session).
# Google Cloud Console -> APIs & Services -> Credentials, for the SAME project
# Firebase created for you. The "Web client (auto created by Google Service)"
# entry is EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID — that's the only one required to
# test in Expo Go. iOS/Android client IDs are only needed for a native
# (EAS Dev Client) build later.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Backend API base URL (used starting in the sync pass; harmless to set now).
EXPO_PUBLIC_API_URL=http://localhost:4000
