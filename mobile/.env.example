# Firebase Web app config — Firebase Console -> Project settings -> General ->
# "Your apps" -> Web app (</> icon). Register a Web app even though this is a
# React Native project: the Firebase JS SDK uses this config on all platforms.
# Also make sure Authentication -> Sign-in method -> Email/Password is enabled.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Backend API base URL — used for login (GET /api/auth/me) and for syncing
# completed services + photos/signatures to the server.
EXPO_PUBLIC_API_URL=http://localhost:4000
