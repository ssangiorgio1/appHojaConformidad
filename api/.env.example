PORT=4000
NODE_ENV=development

MONGODB_URI=

# Firebase Admin SDK service account (Firebase Console -> Project settings -> Service accounts)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Only emails ending in this domain are allowed to authenticate
ALLOWED_EMAIL_DOMAIN=waragps.com

# This account's role/activo can never be changed through the API — always a way in
PROTECTED_SUPERADMIN_EMAIL=joacosangiorgio1@gmail.com

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Odoo (helpdesk tickets) — backend-only, never exposed to the mobile app
ODOO_URL=
ODOO_DB=
ODOO_EMAIL=
ODOO_API_KEY=

CORS_ORIGINS=http://localhost:3000
