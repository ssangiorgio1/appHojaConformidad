PORT=4000
NODE_ENV=development
ROUTING_URL=http://localhost:5000
MONGODB_URI=

# Firebase Admin SDK service account (Firebase Console -> Project settings -> Service accounts)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Only emails ending in this domain are allowed to authenticate
ALLOWED_EMAIL_DOMAIN=waragps.com

# This account's role/activo can never be changed through the API — always a way in
PROTECTED_SUPERADMIN_EMAIL=joacosangiorgio1@gmail.com

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Odoo (helpdesk tickets) — backend-only, never exposed to the mobile app
ODOO_URL=
ODOO_DB=
ODOO_EMAIL=
ODOO_API_KEY=

# Encrypts each técnico's personal Odoo password at rest. Any random string
# of 16+ chars — generate once and never change it (changing it makes every
# already-linked Odoo account unreadable, técnicos would need to re-link).
ODOO_LINK_SECRET=

# Comma-separated list. In production (e.g. Render) include the deployed
# web dashboard's origin — the mobile app isn't affected by CORS.
CORS_ORIGINS=http://localhost:3000

# Servidor de rutas por calle (OSRM, ver routing/ en la raíz del repo). Opcional: sin esto el panel usa las zonas por radio.
# ROUTING_URL=http://localhost:5000

# Apagada por defecto. Con 1, la constancia de visita fallida se manda al ticket de Odoo apenas el técnico reporta "No está en el lugar".
# CONSTANCIA_AL_REPORTAR=1
